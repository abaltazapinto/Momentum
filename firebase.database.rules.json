{
  "rules": {
    ".read": false,
    ".write": false,
    "endorsements": {
      ".read": true,
      ".write": true
    },
    "tasks": {
      ".read": "auth != null && auth.uid === root.child('legacyOwner').val()",
      ".write": false
    },
    "users": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid",
        "tasks": { "$taskId": { ".validate": "newData.hasChildren(['title'])" } }
      }
    }
  }
}
